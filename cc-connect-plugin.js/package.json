{
  "name": "@wildfirechat/cc-connect-plugin",
  "version": "1.0.0",
  "description": "野火IM与cc-connect的桥接插件 (Node.js版)",
  "license": "MIT",
  "author": "WildfireChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/wildfirechat/robot-gateway.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "cc-connect-plugin": "./bin/cc-connect-plugin.js"
  },
  "files": [
