    "websocket",
    "bridge"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@wildfirechat/robot-gateway-client-sdk": "^1.0.5",
    "@wildfirechat/server-sdk": "^1.0.3",
    "ws": "^8.16.0"
  }
}
