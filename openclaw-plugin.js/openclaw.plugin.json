{
  "id": "wildfire",
  "name": "Wildfire IM",
  "version": "1.0.0",
  "description": "Wildfire IM channel for OpenClaw",
  "author": "Wildfire IM Team",
  "channels": [
    "wildfire"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "imUrl": {
        "type": "string",
        "description": "Wildfire IM im-server URL, e.g. http://im-server",
        "default": ""
      },
      "robotId": {
        "type": "string",
        "description": "Robot ID",
        "default": ""
      },
      "robotSecret": {
        "type": "string",
        "description": "Robot secret",
        "default": ""
      },
      "requireMention": {
        "type": "boolean",
        "default": true,
        "description": "Whether replies in groups require mentioning the robot"
      },
      "helpKeywords": {
        "type": "string",
        "default": "帮,请,分析,总结",
        "description": "Comma-separated keywords that trigger bot response in groups"
      },
      "accounts": {
        "type": "object",
        "description": "Multi-account configuration keyed by accountId",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "imUrl": {
              "type": "string",
              "default": ""
            },
            "robotId": {
              "type": "string",
              "default": ""
            },
            "robotSecret": {
              "type": "string",
              "default": ""
            },
            "requireMention": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "imUrl": {
      "label": "Wildfire IM-Server URL",
      "placeholder": "http://im-server.com"
    },
    "robotId": {
      "label": "Robot ID"
    },
    "robotSecret": {
      "label": "Robot Secret",
      "sensitive": true
    },
    "requireMention": {
      "label": "Require Mention in Group"
    },
    "helpKeywords": {
      "label": "Help Keywords"
    }
  }
}
