{
  "name": "@wildfirechat/dsh-wildfire",
  "version": "0.1.0",
  "description": "Wildfire IM channel plugin for DeepSeek Harness (dsh)",
  "license": "MIT",
  "author": "Wildfire IM Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildfirechat/robot-gateway.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "dsh": {
    "channel": {
      "id": "wildfire",
      "label": "Wildfire IM",
      "blurb": "Wildfire IM protocol channel via @wildfirechat/robot-gateway-client-sdk"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@wildfirechat/robot-gateway-client-sdk": "file:../client.js",
    "@wildfirechat/server-sdk": "^1.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7",
    "cordis": ">=4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
